{
  "name": "english-master-ai-api",
  "main": "worker.js",
  "compatibility_date": "2026-11-04",
  "vars": {
    "OPENAI_MODEL": "gpt-6-astra"
  },
  "ratelimits": [
    {
      "name": "CHAT_LIMITER",
      "namespace_id": "1001001",
      "simple": {
        "limit": 8,
        "period": 60
      }
    }
  ],
  "secrets": {
    "required": [
      "OPENAI_API_KEY",
      "TURNSTILE_SECRET"
    ]
  }
}